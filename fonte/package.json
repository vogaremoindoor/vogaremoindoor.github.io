{
  "name": "treino-remo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cadastro e execução de treinos de remo com contador regressivo, voga e sinal sonoro.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "start": "node server/index.js",
    "test": "node --test",
    "treinos:indice": "node scripts/indice-treinos.mjs",
    "publicar:pages": "node scripts/publicar-pages.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}
